<?xml version="1.0"?>
<robot name="export cases" xmlns:xacro="http://ros.org/wiki/xacro">
  <link name="base_link">
  </link>
  <link name="hinge target">
  </link>
  <joint name="base_link_hinge target_joint" type="fixed">
    <parent link="base_link"/>
    <child link="hinge target"/>
    <origin xyz="0 -0.1 0" rpy="0 0 0"/>
  </joint>
  <link name="slider target">
  </link>
  <joint name="base_link_slider target_joint" type="fixed">
    <parent link="base_link"/>
    <child link="slider target"/>
    <origin xyz="0 0.1 0" rpy="0 0 0"/>
  </joint>
  <link name="primitive bounding object">
    <visual>
      <geometry>
        <box size="0.02 0.04 0.06"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.04 0.06"/>
      </geometry>
    </collision>
  </link>
  <joint name="base_link_primitive bounding object_joint" type="fixed">
    <parent link="base_link"/>
    <child link="primitive bounding object"/>
    <origin xyz="0.1 0 0" rpy="0 0 0.4"/>
  </joint>
  <link name="tilted camera">
  </link>
  <joint name="base_link_tilted camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="tilted camera"/>
    <origin xyz="0.05 0.01 0.1" rpy="-2.111674 0.231394 -1.494436"/>
  </joint>
  <link name="ts_emitter">
  </link>
  <joint name="base_link_ts_emitter_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ts_emitter"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
</robot>
