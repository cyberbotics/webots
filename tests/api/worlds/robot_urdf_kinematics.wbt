  direction 0.5 0.5 -1
}
Robot {
  translation 0 0 0.5
  rotation 0 0 1 0.3
  children [
    TestSuiteEmitter {
    }
    Pose {
      translation 0.1 0.05 0
      rotation 1 0 0 0.7
      children [
        HingeJoint {
          jointParameters HingeJointParameters {
            axis 0 1 0.3
            anchor 0.02 0.03 0.1
          }
          device [
            RotationalMotor {
              name "hinge in rotated pose"
              minPosition -2
              maxPosition 2
            }
          ]
          endPoint Solid {
            translation 0.05 0.04 0.2
            rotation 0 0 1 0.4
            children [
              Pose {
                translation 0 0 0.1
                rotation 0 1 0 0.5
                children [
                  SliderJoint {
                    jointParameters JointParameters {
                      axis 1 0 0
                    }
                    device [
                      LinearMotor {
                        name "slider in rotated pose"
                        minPosition -0.1
                        maxPosition 0.1
                      }
                    ]
                    endPoint Solid {
                      translation 0 0 0.05
                      rotation 1 0 0 0.3
                      children [
                        HingeJoint {
                          jointParameters HingeJointParameters {
                            axis 1 0 0
                            anchor 0 0.02 0
                          }
                          device [
                            RotationalMotor {
                              name "hinge after slider"
                            }
                          ]
                          endPoint Solid {
                            translation 0 0.05 0.03
                            name "link 3"
                          }
                        }
                      ]
                      name "link 2"
                    }
                  }
                ]
              }
              HingeJoint {
                jointParameters HingeJointParameters {
                  axis 0 0 1
                  anchor 0.03 0 0
                }
                device [
                  RotationalMotor {
                    name "sibling hinge"
                    minPosition -1
                    maxPosition 1
                  }
                ]
                endPoint Solid {
                  translation 0.06 0.01 0
                  name "link 4"
                }
              }
            ]
            name "link 1"
          }
        }
      ]
    }
  ]
  name "joints in rotated poses"
  controller "robot_urdf_kinematics"
  controllerArgs [
    "rotated_poses"
  ]
  supervisor TRUE
}
